{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gizlet",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "gizlet.io", "custom_domain": true },
    { "pattern": "www.gizlet.io", "custom_domain": true },
    { "pattern": "dl.gizlet.io", "custom_domain": true },
    { "pattern": "api.gizlet.io", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gizlet",
      "database_id": "aea72ef2-aafb-4a5a-b6dc-047c9953788f",
      "migrations_dir": "migrations/d1"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6676943a0aeb4aefb65f375f98f3c0e3",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:18789/postgres?sslmode=disable"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gizlet-assets" }],
  "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["hello@gizlet.io"] }],
  "queues": {
    "producers": [{ "binding": "MIRROR", "queue": "gizlet-mirror" }],
    "consumers": [
      {
        "queue": "gizlet-mirror",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "gizlet-mirror-dlq"
      }
    ]
  },
  "triggers": { "crons": ["*/10 * * * *", "17 */6 * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://gizlet.io",
    "DL_ORIGIN": "https://dl.gizlet.io",
    "API_ORIGIN": "https://api.gizlet.io",
    "GITHUB_WEB": "https://github.com",
    "GITHUB_RAW": "https://raw.githubusercontent.com",
    "GITHUB_API": "https://api.github.com",
    "GITHUB_APP_CLIENT_ID": "Iv23lif9pSWFmY0bplOK",
    "GITHUB_APP_SLUG": "gizlet-bot",
    "REFRESH_AFTER_SECONDS": "120",
    "OIDC_ISSUER": "https://token.actions.githubusercontent.com",
    "OIDC_AUDIENCE": "https://api.gizlet.io",
    "KEEP_MIRRORED_RELEASES": "2",
    "DEV_HOST_OVERRIDE": "0",
    "MAIL_FROM": "Gizlet <hello@gizlet.io>"
  },
  "observability": { "enabled": true }
}
