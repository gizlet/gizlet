    name = "gizlet",
    srcs = [
        "main.c",
        "terminal.c",
        "terminal.h",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    target_compatible_with = select({
